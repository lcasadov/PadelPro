# ===== ENVIRONMENT VARIABLES FOR DOCKER COMPOSE =====
# Copy to .env and customize as needed

# JWT Configuration
JWT_SECRET=your-super-secret-key-min-32-chars-change-in-prod-12345
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Encryption (for system_config secrets in configuracion-club)
# Must be 32+ characters
ENCRYPTION_KEY=your-encryption-key-min-32-chars-change-in-prod-123456789

# PostgreSQL
POSTGRES_DB=padelpro
POSTGRES_USER=padelpro
POSTGRES_PASSWORD=padelpro_dev

# Bootstrap admin (acceso-cuenta-prod D1)
# On first start with NO existing ADMIN, the backend creates an ACTIVE admin from these
# credentials (BCrypt-hashed at runtime). Idempotent: ignored once an admin exists.
# Leave empty to skip seeding. Use a strong password; rotate after first login.
ADMIN_EMAIL=admin@yourclub.local
ADMIN_PASSWORD=change-this-strong-admin-password

# Spring Boot Profile
SPRING_PROFILES_ACTIVE=prod

# API Base URL (for frontend to reach backend)
VITE_API_BASE_URL=http://localhost:8080

# ===== DEVELOPMENT NOTES =====
# - JWT_SECRET and ENCRYPTION_KEY must be ≥ 32 characters
# - Use strong random values in production
# - Change POSTGRES_PASSWORD in production
# - Never commit .env to version control
